{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HardHub",
  "version": "1.0.2",
  "identifier": "com.hardsuite.hardhub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1424",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HardHub",
        "theme": "Dark",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "dragDropEnabled": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "appPosition": {
          "x": 170,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 180
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  }
}
